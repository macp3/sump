# ===================================================
# SUMP - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git!
# ===================================================

# Security / JWT
SECRET_KEY=change_this_to_a_long_random_secret_string_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
# Local SQLite default:
DATABASE_URL=sqlite:///./sump.db
# Azure PostgreSQL Flexible Server example:
# DATABASE_URL=postgresql://user:password@sump-db.postgres.database.azure.com:5432/sump?sslmode=require

# Relationship configuration (YYYY-MM-DD)
RELATIONSHIP_START_DATE=2024-01-01

# User 1 Configuration
USER1_USERNAME=maciej
USER1_DISPLAY_NAME=Maciej
USER1_INITIAL_PASSWORD=replace_with_secure_password_1

# User 2 Configuration
USER2_USERNAME=selina
USER2_DISPLAY_NAME=Selina
USER2_INITIAL_PASSWORD=replace_with_secure_password_2

# CORS Allowed Origins (comma separated list of URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
